.shell powershell

# Reload whkd configuration
alt + r                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
alt + shift + r         : komorebic reload-configuration



# App Shortcuts / Launchers
alt + return            : start wt
alt + shift + return	: start wt wsl
alt + f                 : start explorer
alt + b                 : start chrome
alt + s			: start slack
alt + n                 : start wsl nvim
alt + o                 : start "C:\Users\lucas\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Obsidian.lnk"
alt + i                 : wt -p "Windows PowerShell" C:\Program Files\bottom\bin\btm.exe # i -> runtime *I*nfo
alt + d                 : start "C:\Users\lucas\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Discord Inc\Discord.lnk"

# Web Apps
alt + c                 : start chrome --app="https://app.hey.com/calendar/weeks/"
alt + g                 : start chrome.exe --app="https://gemini.google.com"

# Window Controls
alt + q                 : komorebic close
alt + m                 : komorebic minimize
alt + v                 : komorebic toggle-float
alt + shift + z         : komorebic toggle-monocle
alt + shift + m         : komorebic manage
alt + shift + u         : komorebic unmanage
alt + shift + t         : komorebic toggle-tiling
alt + shift + p    : komorebic promote

# Focus Navigation
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + u                 : komorebic focus up
alt + k                 : komorebic focus right
alt + shift + oem_4     : komorebic cycle-focus previous # oem_4 is [
alt + shift + oem_6     : komorebic cycle-focus next     # oem_6 is ]

# Move Windows
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right

# Stack Windows
alt + left              : komorebic stack left
alt + down              : komorebic stack down
alt + up                : komorebic stack up
alt + right             : komorebic stack right
alt + oem_1             : komorebic unstack               # oem_1 is ;
alt + oem_4             : komorebic cycle-stack previous  # oem_4 is [
alt + oem_6             : komorebic cycle-stack next      # oem_6 is ]

# Resize Windows
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Window Manager Options
#alt + shift + r         : komorebic retile
alt + p                 : komorebic toggle-pause

# Layouts
alt + x                 : komorebic flip-layout horizontal
alt + y                 : komorebic flip-layout vertical

# Workspaces
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + 7                 : komorebic focus-workspace 6
alt + 8                 : komorebic focus-workspace 7

# Move Windows Across Workspaces
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5
alt + shift + 7         : komorebic move-to-workspace 6
alt + shift + 8         : komorebic move-to-workspace 7

# Focus Monitor / Display (using OEM key codes)
alt + oem_comma  : komorebic focus-monitor 0
alt + oem_period : komorebic focus-monitor 1

# Move Active Window to Monitor / Display
alt + shift + oem_comma  : komorebic move-to-monitor 0
alt + shift + oem_period : komorebic move-to-monitor 1

# Move window to Display 0, Workspaces 1-7
alt + shift + oem_comma + 1 : komorebic move-to-monitor-workspace 0 0
alt + shift + oem_comma + 2 : komorebic move-to-monitor-workspace 0 1
alt + shift + oem_comma + 3 : komorebic move-to-monitor-workspace 0 2
alt + shift + oem_comma + 4 : komorebic move-to-monitor-workspace 0 3
alt + shift + oem_comma + 5 : komorebic move-to-monitor-workspace 0 4
alt + shift + oem_comma + 6 : komorebic move-to-monitor-workspace 0 5
alt + shift + oem_comma + 7 : komorebic move-to-monitor-workspace 0 6

# Move window to Display 1, Workspaces 1-7
alt + shift + oem_period + 1 : komorebic move-to-monitor-workspace 1 0
alt + shift + oem_period + 2 : komorebic move-to-monitor-workspace 1 1
alt + shift + oem_period + 3 : komorebic move-to-monitor-workspace 1 2
alt + shift + oem_period + 4 : komorebic move-to-monitor-workspace 1 3
alt + shift + oem_period + 5 : komorebic move-to-monitor-workspace 1 4
alt + shift + oem_period + 6 : komorebic move-to-monitor-workspace 1 5
alt + shift + oem_period + 7 : komorebic move-to-monitor-workspace 1 6
